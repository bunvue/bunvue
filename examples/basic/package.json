    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5",
    "eslint": "^10.10.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.70.0",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "globals": "^17.12.0"
